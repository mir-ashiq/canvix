# Canvix — environment variables
#
# ── Database (required) ────────────────────────────────────────
# PostgreSQL connection string. Works with any Postgres server.
#
# RECOMMENDED · Supabase (free tier is plenty):
#   1. Create a project at supabase.com
#   2. Dashboard → Connect → copy the URI (either style below)
#   3. Replace [YOUR-PASSWORD] with your database password
#
#   Transaction pooler (best for servers without IPv6):
#     postgresql://postgres.abcdefghij:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
#   Direct connection (needs an IPv6 route on your host):
#     postgresql://postgres:[YOUR-PASSWORD]@db.abcdefghij.supabase.co:5432/postgres
#
#   You do NOT need to add sslmode or pgbouncer flags by hand — Canvix
#   auto-applies them for Supabase (see src/lib/db-url.ts).
#
# Then run:  npm run db:setup   (migrations + 110 template seed, one command)
#
# Other hosts, same format:
#   - Neon (serverless):    postgresql://user:password@ep-xxxx.region.aws.neon.tech/canvix
#   - local install/Docker: postgresql://user:password@localhost:5432/canvix
#     (docker run --name canvix-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=canvix -p 5432:5432 -d postgres:17)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ── AI provider (optional) ─────────────────────────────────────
# Canvix works without any AI provider (local features keep working).
# When these are set, AI features (Magic Layers, Assistant, Magic Write,
# image generation/editing, translate, photo search) activate.
# Credentials are SERVER-SIDE ONLY — never exposed to the browser.
#
# Alternative: place a .z-ai-config JSON file on the server host:
#   { "baseUrl": "https://your-provider.example/v1", "apiKey": "your-key" }
# (checked at the working directory, then ~, then /etc)
#
# ZAI_BASE_URL=https://your-provider.example/v1
# ZAI_API_KEY=your-key

# ── AI agents / MCP server (optional, v0.6) ───────────────────
# Model Context Protocol endpoint: POST /api/mcp
# Lets AI assistants (Claude Desktop, Cursor, ChatGPT, any MCP client)
# create & edit real Canvix designs on this server. Disabled until
# you set a token; requests must send "Authorization: Bearer <token>".
# Generate one with:  openssl rand -hex 24
# CANVIX_MCP_TOKEN=change-me-to-a-long-random-secret
