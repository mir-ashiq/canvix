# Canvix — environment variables
#
# ── Database (required) ────────────────────────────────────────
# PostgreSQL connection string. Works with any Postgres server:
#   - local install:        postgresql://user:password@localhost:5432/canvix
#   - Docker:               postgresql://user:password@localhost:5432/canvix
#   - Neon (serverless):    postgresql://user:password@ep-xxxx.region.aws.neon.tech/canvix?sslmode=require
#   - Supabase / RDS / etc: same format
#
# Local development quick-start (Docker):
#   docker run --name canvix-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=canvix -p 5432:5432 -d postgres:17
DATABASE_URL=postgresql://user:password@localhost:5432/canvix

# ── AI provider (optional) ─────────────────────────────────────
# Canvix works without any AI provider (local features keep working).
# When these are set, AI features (Magic Layers, Assistant, Magic Write,
# image generation/editing, translate, photo search) activate.
# Credentials are SERVER-SIDE ONLY — never exposed to the browser.
#
# Alternative: place a .z-ai-config JSON file on the server host:
#   { "baseUrl": "https://your-provider.example/v1", "apiKey": "your-key" }
# (checked at the working directory, then ~, then /etc)
#
# ZAI_BASE_URL=https://your-provider.example/v1
# ZAI_API_KEY=your-key
