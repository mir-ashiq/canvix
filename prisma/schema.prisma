// v0.9.3: rust-free Prisma client.
//
// The classic prisma-client-js generator ships a native Rust query
// engine binary — fine on Vercel/self-hosted Node, impossible on edge
// runtimes like Cloudflare Workers. The new `prisma-client` generator
// (GA path toward Prisma 7) emits the TypeScript/WASM client that runs
// anywhere JS runs and talks to Postgres through a real `pg` driver
// (src/lib/db.ts wires @prisma/adapter-pg). Rust-free is the default
// since 6.16 — no preview flags needed.
//
// The client is generated to src/generated/prisma (gitignored,
// regenerated by postinstall / `npm run db:generate`) — imports are
// `@/generated/prisma` in app code and relative paths in scripts.
// (prisma-client-js was tried first: even with the queryCompiler flag
// it silently generates the library-engine client — engineWasm stays
// undefined. prisma-client-es needs an extra package; `prisma-client`
// is built into the CLI, and engineType="client" flips it to the
// TypeScript/WASM query compiler.)
generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── v0.9.0: accounts ─────────────────────────────────────────
// Username/password accounts — deliberately self-contained (no email,
// no OAuth, no external provider) so self-hosting stays free forever.
// Passwords are scrypt hashes from node:crypto (see src/lib/auth/passwords.ts).
model User {
  id           String    @id @default(cuid())
  // lowercase, 3–32 chars, [a-z0-9_-] (enforced in src/lib/auth/validate.ts)
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  designs      Design[]  @relation("DesignOwner")
  sessions     Session[]
}

// Opaque server-side sessions. The cookie carries the raw token; the row
// id is sha256(token) — a DB leak never yields usable tokens.
model Session {
  id        String   @id // sha256(token) hex
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

// A user design / project — the core artifact of Canvix.
model Design {
  id         String          @id @default(cuid())
  name       String          @default("Untitled design")
  width      Int             @default(1080)
  height     Int             @default(1080)
  // Structured document: { pages: PageData[], ... } — stored as native jsonb
  pages      Json            @default("[]")
  thumbnail  String?         // small dataURL preview
  source     String          @default("blank") // blank | template:<id> | duplicate:<id> | resize:<id>
  // v0.9: owning account. null = link-accessible design (pre-accounts
  // behaviour — anonymous editing keeps working for legacy + shared links).
  ownerId    String?
  owner      User?           @relation("DesignOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // v0.9.1: anonymous attribution — sha256 of the canvix_anon cookie that
  // was set when an anonymous browser created this design. adopt-all only
  // claims rows whose anonKey matches the caller's cookie, so one account
  // can never sweep up another person's anonymous work. null = legacy
  // design created before attribution existed (claimable only via the
  // explicit per-design adopt endpoint).
  anonKey    String?
  // soft delete (dashboard Trash) — null = live design
  deletedAt  DateTime?
  versions   DesignVersion[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([ownerId])
  @@index([anonKey])
}

// Server-side version snapshots for a design (Canva "Version history").
model DesignVersion {
  id        String   @id @default(cuid())
  designId  String
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  label     String   @default("Version")
  name      String
  width     Int
  height    Int
  pages     Json
  createdAt DateTime @default(now())

  @@index([designId, createdAt(sort: Desc)])
}

// Built-in starter templates rendered in the dashboard & editor.
model Template {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  category  String // social | presentation | print | logo | thumbnail
  width     Int
  height    Int
  pages     Json // structured document — same shape as Design.pages
  accent    String   @default("#00C4CC") // card decoration
  createdAt DateTime @default(now())
}

// ── v0.5.0: collaboration, comments & AI infrastructure ──────

// Append-only operation log — the replication stream for live collaboration.
// `id` is a global monotonic sequence: clients track their last seen seq and
// replay from any offset after reconnecting (SSE `?since=<seq>`).
model DesignEvent {
  id        BigInt   @id @default(autoincrement())
  designId  String
  actorId   String // participant id (client-generated)
  kind      String // op name — see research/COLLABORATION-ARCHITECTURE.md §3
  payload   Json
  // v0.10.1: the client's dedupe key for this op. Unique per design so a
  // retried flush (network drop / function timeout mid-batch) is a no-op
  // instead of a duplicate — at-least-once delivery becomes exactly-once.
  // Nullable: rows written before v0.10.1 have none (Postgres unique
  // indexes ignore NULLs, so legacy rows never conflict).
  eventId   String?
  createdAt DateTime @default(now())

  @@unique([designId, eventId])
  @@index([designId, id(sort: Desc)])
}

// Live presence per participant per design (heartbeat-based).
// v0.10.1: the primary key is (designId, id) — participant identity is
// per-BROWSER (src/lib/collab/identity.ts) and one browser can edit two
// designs at once (two tabs). The old single-column PK on id made presence
// exclusive to one design: every heartbeat for a second design failed with
// P2002 (production incident 2026-10-29).
model Presence {
  id        String // = participant id
  designId  String
  name      String
  color     String
  cursor    Json? // { page: number, x: number, y: number, selection?: string[] }
  lastSeen  DateTime @default(now()) @updatedAt

  @@id([designId, id])
  @@index([designId, lastSeen])
}

// Canvas-anchored comment threads (author identity is the local participant).
model Comment {
  id          String    @id @default(cuid())
  designId    String
  pageId      String
  x           Float // anchor in page coordinates (fraction of page size, 0..1)
  y           Float
  elementId   String? // optional element anchor — pin follows the element
  authorId    String
  authorName  String
  authorColor String
  body        String
  parentId    String? // reply threading
  resolved    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([designId, createdAt])
  @@index([designId, resolved])
}

// ── v0.11: media store (audio/video uploads) ─────────────────
// A/V files are far too large for the dataURL-in-element pattern images
// use (multi-MB per autosave). They live here as bytea; elements
// reference them by id (`/api/media/<id>`). Chunks are appended with a
// raw `bytes || chunk` UPDATE (offset-guarded) because serverless body
// limits force chunked uploads. Access mirrors designs: link-accessible
// once the id is known; ownership columns exist for future GC/quota.
model Media {
  id          String    @id @default(cuid())
  mime        String
  size        Int
  bytes       Bytes
  ownerId     String?
  anonKey     String?
  // set by finalize — GET 404s until the upload is complete
  finalizedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([ownerId])
  @@index([anonKey])
  @@index([finalizedAt, createdAt])
}

// Provider accounting + abuse telemetry for AI routes.
model AIUsage {
  id        String   @id @default(cuid())
  feature   String // write | image | image-edit | translate | assistant | magic-layers | search
  provider  String // zai | local
  ok        Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
