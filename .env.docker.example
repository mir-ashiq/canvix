# Canvix Docker self-host — environment file
#
#   cp .env.docker.example .env    (next to docker-compose.yml)
#   edit POSTGRES_PASSWORD, then:  docker compose up -d
#
# App → http://localhost:3000  (migrations run automatically on
# boot; the 366-template library syncs itself from code — there is
# no seed step).

# ── Required ─────────────────────────────────────────────────────
# Password for the compose Postgres. Generate one:
#   openssl rand -hex 24
# (Used only inside the compose network; the app connects with it.)
POSTGRES_PASSWORD=change-me-to-a-long-random-secret

# ── Database override (rarely needed) ────────────────────────────
# By default the app talks to the compose "db" service:
#   postgresql://canvix:${POSTGRES_PASSWORD}@db:5432/canvix?sslmode=disable
# To use your OWN Postgres (Supabase/Neon/RDS/external), set
# DATABASE_URL here and comment out the db service in
# docker-compose.yml (plus the app's depends_on). Hosted URLs work
# as-is — Canvix auto-applies TLS/pooler flags (src/lib/db-url.ts).
# DATABASE_URL=postgresql://user:pass@host:5432/canvix

# Host port for the app (default 3000). Change if 3000 is taken:
# CANVIX_PORT=3000

# ── Optional integrations (all default off; the app degrades
#    honestly without them — see .env.example for the full
#    reference of every variable and what it unlocks) ────────────
# AI provider (Magic Layers, Assistant, Magic Write, image gen…):
# ZAI_BASE_URL=https://your-provider.example/v1
# ZAI_API_KEY=your-key

# Stock video (Pexels/Pixabay) + sound (Freesound) search:
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# FREESOUND_API_KEY=

# AI agents / MCP endpoint (POST /api/mcp):
# CANVIX_MCP_TOKEN=change-me-to-a-long-random-secret

# Plugins (third-party sandboxed iframe apps):
# CANVIX_PLUGINS=1

# Admin bootstrap (comma-separated usernames promoted on first
# login — see docs/ADMIN.md):
# CANVIX_ADMIN_USERS=your-username

# Rate limits / observability / template-sync opt-out:
# CANVIX_RATE_LIMITS=off
# CANVIX_LOG=requests
# CANVIX_ERROR_WEBHOOK_URL=
# CANVIX_TEMPLATE_SYNC=0
