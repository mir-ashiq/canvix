{
  "name": "canvix",
  "version": "0.22.1",
  "private": false,
  "description": "Canvix — free & open-source graphic design tool. A community-built Canva alternative.",
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "node scripts/build.mjs",
    "postinstall": "prisma generate && node scripts/patch-prisma-wasm.mjs",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate && node scripts/patch-prisma-wasm.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "test:mcp": "bash scripts/mcp-e2e.sh",
    "typecheck": "tsc --noEmit",
    "db:setup": "bash scripts/db-setup.sh",
    "db:migrate:deploy": "prisma migrate deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@prisma/adapter-pg": "^6.16.0",
    "@prisma/client": "^6.16.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "konva": "^10.3.2",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "pg-cloudflare": "^1.4.1",
    "prisma": "^6.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.2.5",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.1",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.5",
    "@opennextjs/cloudflare": "^1.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "@imgly/background-removal": {
      "zod": "^4.6.7"
    },
    "minimatch@^10.2.2": "^11.0.8",
    "@node-minify/core": {
      "glob": "^14.0.5"
    },
    "@opennextjs/cloudflare": {
      "glob": "^14.0.5"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    }
  },
  "allowScripts": {
    "sharp@0.35.5": true,
    "workerd@1.20261023.1": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  }
}
